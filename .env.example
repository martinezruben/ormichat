# Copiar a .env y completar. Generar secretos con: openssl rand -hex 64

# URL pública con HTTPS (webhooks, enlaces en emails y widget)
FRONTEND_URL=https://chat.example.com

SECRET_KEY_BASE=
POSTGRES_PASSWORD=

# Solo si ya existe un volumen de Postgres creado con otras credenciales
# (Postgres no las cambia en un volumen existente):
# POSTGRES_USER=ormichat
# POSTGRES_DB=ormichat_production

# Por defecto es true (redirige a HTTPS y envía HSTS). El proxy TLS debe enviar X-Forwarded-Proto.
# Poner false solo para probar sin proxy en http://localhost:3000.
# FORCE_SSL=true

# Respaldos automáticos (servicio `backup`): días a conservar en ./backups
# BACKUP_KEEP_DAYS=14

ENABLE_ACCOUNT_SIGNUP=false
DEFAULT_LOCALE=es
RACK_TIMEOUT_SERVICE_TIMEOUT=120
